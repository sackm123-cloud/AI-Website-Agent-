      "source": [
        "```env\n",
        "# =========================================================\n",
        "# AI STEM AUTOMATION HUB\n",
        "# Environment Configuration\n",
        "# =========================================================\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GEMINI AI\n",
        "# =========================================================\n",
        "\n",
        "GEMINI_API_KEY=your_gemini_api_key_here\n",
        "\n",
        "GEMINI_MODEL=gemini-2.5-flash\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GMAIL SMTP\n",
        "# =========================================================\n",
        "\n",
        "GMAIL_ADDRESS=yourgmail@gmail.com\n",
        "\n",
        "GMAIL_APP_PASSWORD=your_16_character_app_password\n",
        "\n",
        "GMAIL_TO=yourgmail@gmail.com\n",
        "\n",
        "GMAIL_FROM_NAME=AI STEM Automation Hub\n",
        "\n",
        "SMTP_HOST=smtp.gmail.com\n",
        "\n",
        "SMTP_PORT=465\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GITHUB\n",
        "# =========================================================\n",
        "\n",
        "GITHUB_TOKEN=your_github_token_here\n",
        "\n",
        "GITHUB_REPOSITORY=sackm123-cloud/Kaggriculture-competition\n",
        "\n",
        "GITHUB_TIMEOUT=20\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# AUTOMATION SCHEDULER\n",
        "# =========================================================\n",
        "\n",
        "AUTOMATION_TIMEZONE=Asia/Kolkata\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DAILY AI / ROBOTICS NEWS\n",
        "# =========================================================\n",
        "\n",
        "NEWS_HOUR=8\n",
        "\n",
        "NEWS_MINUTE=0\n",
        "\n",
        "NEWS_MAX_ARTICLES=15\n",
        "\n",
        "WEB_SEARCH_TIMEOUT=15\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DAILY STEM TIP\n",
        "# =========================================================\n",
        "\n",
        "STEM_TIP_HOUR=9\n",
        "\n",
        "STEM_TIP_MINUTE=0\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DAILY PROJECT IDEA\n",
        "# =========================================================\n",
        "\n",
        "PROJECT_HOUR=10\n",
        "\n",
        "PROJECT_MINUTE=0\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEM CLASS UPDATE\n",
        "# =========================================================\n",
        "\n",
        "CLASS_UPDATE_HOUR=16\n",
        "\n",
        "CLASS_UPDATE_MINUTE=30\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# COMPETITION UPDATE\n",
        "# =========================================================\n",
        "\n",
        "COMPETITION_HOUR=18\n",
        "\n",
        "COMPETITION_MINUTE=0\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# WEEKLY REPORT\n",
        "# =========================================================\n",
        "\n",
        "WEEKLY_REPORT_DAY=fri\n",
        "\n",
        "WEEKLY_REPORT_HOUR=17\n",
        "\n",
        "WEEKLY_REPORT_MINUTE=0\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# OPTIONAL\n",
        "# =========================================================\n",
        "\n",
        "NEWS_HOURS=24\n",
        "\n",
        "LOG_LEVEL=INFO\n",
        "```\n"
      ]
    }
